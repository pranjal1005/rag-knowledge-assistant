# Copy this file to .env and fill in what you need.
# Only ONE of the three API keys below is required, matching LLM_PROVIDER.
# Embeddings run locally and need no key at all.

# --- LLM provider: "anthropic", "openai", or "gemini" ---
# "gemini" is the free option -- Google AI Studio's free tier needs no
# credit card. Anthropic and OpenAI both require a minimum paid credit
# before their API keys work at all.
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings (local model, downloaded on first run — no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
# Leave CHROMA_HOST empty for local/no-Docker dev (uses an on-disk store at
# CHROMA_PERSIST_DIR). docker-compose.yml sets CHROMA_HOST=chroma for you
# automatically — you don't need to set it by hand for the Docker path.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
